# ─────────────────────────────────────────────────────────────
# PIXEL PING — همه متغیرها اختیاری‌اند!
# پنل بدون هیچ‌کدام از این‌ها هم خودکار بالا می‌آید:
#   • SESSION_SECRET → خودکار ساخته و در دیتابیس ذخیره می‌شود
#   • رمز ادمین اولیه → خودکار قوی ساخته و در لاگ استارت چاپ می‌شود
#   • مسیر دیتابیس → خودکار /data پیدا می‌شود (یا fallback محلی)
# ─────────────────────────────────────────────────────────────

# مسیر دیتابیس SQLite — روی Railway با Volume در مسیر /data
DATABASE_URL=file:/data/pixelping.db

# نام کاربری ادمین اولیه (پیش‌فرض: admin)
# DEFAULT_ADMIN_USER=admin

# رمز ادمین اولیه — اگر خالی باشد رمز قوی تصادفی ساخته و در لاگ‌های
# استارت چاپ می‌شود. فقط بار اول (قبل از اولین لاگین) اثر دارد.
# DEFAULT_ADMIN_PASS=

# کلید امضای کوکی نشست — اگر خالی باشد خودکار ساخته می‌شود.
# برای اعمال دستی، یک رشته تصادفی طولانی بگذارید (openssl rand -hex 32)
# SESSION_SECRET=

# غیرفعال کردن کاربران و لاگ‌های نمونه: مقدار را 0 بگذارید
# DEMO_DATA=1
